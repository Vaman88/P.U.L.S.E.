[Unit]
Description=PULSE website
After=pulse-api.service

[Service]
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Type=simple
WorkingDirectory=/root/projects/PULSE/website/frontend
ExecStart=/usr/bin/python3 -m http.server 3141 --bind 127.0.0.1 --directory .
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
