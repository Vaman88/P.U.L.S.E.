# Environment Variables
# Copy this file to .env and fill in the values

# Backend
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
COOKIE_SECURE=false
# Set this to the exact external HTTPS origin when deploying behind a proxy.
PUBLIC_ORIGIN=
ENABLE_LEGACY_SERVER_TRAINING=false
TRUSTED_PROXY_IPS=[]
# Compose trusts its frontend service name automatically; set exact proxy IPs
# here for other deployments, or configure TRUSTED_PROXY_HOSTNAMES.
TRUSTED_PROXY_HOSTNAMES=["frontend"]
OPENFDA_API_KEY=
# Leave blank for a local demo; the backend creates and persists a local key.
# For a hosted deployment, set a unique cryptographically random secret of at
# least 32 bytes, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# For a host secret file instead of SECRET_KEY. The cloud Compose overlay sets this.
SECRET_KEY_FILE=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (if using)
# DATABASE_URL=sqlite:///./data/pharmacy.db

# CORS
# For a hosted same-origin frontend, use []; otherwise list only exact HTTPS origins.
CORS_ORIGINS=["http://localhost:3141","http://localhost:5173","http://127.0.0.1:3141","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Model
MODEL_PATH=./ml/models
